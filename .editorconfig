root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# Components that are still indented with four spaces (until they get formatted).
[src/components/{BaseModal,Compressor,Equalizer,Fader,Footer,GuitarModal,Knob,Menu,Mixer,PianoModal,SequenceMarker,Sequencer}.vue]
indent_size = 4

[src/components/audio/{RotaryKnob,VerticalFader}.vue]
indent_size = 4
