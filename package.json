{
  "name": "guitarappvue",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --host 127.0.0.1 --port 4173",
    "dev:e2e": "vite --host 127.0.0.1 --port 4175",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:ci": "npm run test:coverage && npm run typecheck && npm run lint && npm run test:e2e",
    "test:e2e:install": "playwright install chromium",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "build:check": "npm run build && npm run check:bundle",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"**/*.{ts,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,mjs}\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@types/vexflow": "^1.2.42",
    "fastdom": "^1.0.11",
    "fflate": "^0.8.2",
    "interactjs": "^1.10.17",
    "lz-string": "^1.5.0",
    "mitt": "^3.0.0",
    "sass": "^1.60.0",
    "tinycolor2": "^1.6.0",
    "vanilla-picker": "^2.12.1",
    "vexflow": "^4.1.0",
    "vue": "^3.2.47"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.29",
    "@types/tinycolor2": "^1.4.6",
    "@vitejs/plugin-vue": "^4.1.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.4.0",
    "eslint-plugin-vue": "^10.9.1",
    "fast-check": "^3.23.2",
    "globals": "^17.6.0",
    "happy-dom": "^20.0.10",
    "husky": "^9.1.7",
    "jsdom": "^27.0.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.10",
    "typescript": "^4.9.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^4.2.0",
    "vitest": "^4.0.18",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^1.2.0"
  },
  "lint-staged": {
    "*.{ts,mjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write --ignore-unknown"
    ],
    "*.vue": "eslint --fix --no-warn-ignored"
  }
}
